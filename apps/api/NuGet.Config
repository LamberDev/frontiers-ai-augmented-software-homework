<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped to apps/api so builds and restores are reproducible and do not depend on
  machine-local/private feeds configured elsewhere (e.g. a corporate Azure Artifacts
  feed that may require credentials unrelated to this project).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
